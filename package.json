{
  "name": "home-conf-doc-verify",
  "version": "0.1.0",
  "description": "Section-scoped Markdown contract verification",
  "type": "module",
  "bin": {
    "doc-verify": "doc-verify/dist/cli.js",
    "home-conf-privacy-scan": "skills/privacy-review/scripts/privacy_gate"
  },
  "files": [
    "doc-verify/dist",
    "doc-verify/lib",
    ".pre-commit-hooks.yaml",
    "skills/privacy-review"
  ],
  "scripts": {
    "build": "tsc -p doc-verify/tsconfig.build.json && cp doc-verify/src/kernel/core.pl doc-verify/dist/kernel/core.pl && chmod +x doc-verify/dist/cli.js",
    "prepare": "npm run build && common=\"$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)\" && if [ -n \"$common\" ] && [ \"$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)\" = \"$common\" ] && command -v prek >/dev/null 2>&1; then prek install --git-dir \"$common\" -t pre-commit; fi",
    "test": "npm run build && vitest run",
    "test:kernel-slow": "npm run build && node doc-verify/tests/kernel-slow/run-kernel-slow.mjs",
    "typecheck": "tsc -p doc-verify/tsconfig.json --noEmit",
    "lint": "node scripts/oxlint-gate.mjs --self-test",
    "check": "node skills/worktree-sop/scripts/run-admitted-check.mjs",
    "check:compound": "npm run build && node doc-verify/dist/cli.js check --paths design/02-programmatic-document-contract-verification.md goals/01-document-verification-and-skill-transfer.md --profile draft --format text",
    "mutate": "npm run build && node scripts/run-mutate-tables.mjs",
    "test:remote-hook": "bash doc-verify/tests/remote-hook.sh",
    "test:mutations": "node scripts/run-mutation-runners.mjs",
    "check:tracked-ignored": "node scripts/check-tracked-ignored.mjs",
    "test:prepare-guard": "bash doc-verify/tests/prepare-guard.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "deepclause-sdk": "0.0.89",
    "fast-glob": "3.3.3",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "minimatch": "10.0.3",
    "remark-parse": "11.0.0",
    "swipl-wasm": "8.2.2",
    "unified": "11.0.5",
    "yaml": "2.8.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.5.2",
    "clingo-wasm": "0.6.0",
    "eslint": "9.36.0",
    "fast-check": "4.10.2",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
