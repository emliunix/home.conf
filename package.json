{
  "name": "home-conf-doc-verify",
  "version": "0.1.0",
  "description": "Section-scoped Markdown contract verification",
  "type": "module",
  "bin": {
    "doc-verify": "doc-verify/dist/cli.js"
  },
  "files": [
    "doc-verify/dist",
    "doc-verify/contracts",
    ".pre-commit-hooks.yaml"
  ],
  "scripts": {
    "build": "tsc -p doc-verify/tsconfig.build.json",
    "prepare": "npm run build",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -p doc-verify/tsconfig.json --noEmit",
    "lint": "eslint doc-verify/src doc-verify/tests",
    "check": "npm run build && node doc-verify/dist/cli.js check --paths design/02-programmatic-document-contract-verification.md goals/01-document-verification-and-skill-transfer.md --profile draft --format text",
    "verify:jev": "npm run build && node doc-verify/dist/parity.js",
    "test:remote-hook": "bash doc-verify/tests/remote-hook.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "deepclause-sdk": "0.0.89",
    "fast-glob": "3.3.3",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "minimatch": "10.0.3",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.8.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.5.2",
    "eslint": "9.36.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
