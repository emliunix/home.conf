#!/usr/bin/env sh
# privacy_gate -- the prek hook. Rejects on a secret; never rewrites content.
#
# ⚠ THE SPLIT IS THE DESIGN (#50 rev 7, @CowBoy). Gitleaks owns DETECTION and REDACTION; this wrapper
# owns everything Gitleaks cannot express, which it was measured not to:
#
#   1. THE CALLER'S REPOSITORY. With `language: script` the process runs from the HOOK checkout, so a bare
#      `.` scans home.conf while the consumer's staged secret sits in the consumer's repo. Measured as
#      exit 3 "no staged files" against a repository that plainly had one. Resolved from the INVOKING
#      directory, not from $0.
#   2. THE STAGED-FILE POPULATION. `gitleaks git --staged` reports "0 commits scanned" while finding two
#      leaks -- its counter is COMMITS, not files. This counts files.
#   3. ZERO-FILE REFUSAL. An empty staged set makes Gitleaks exit 0 with "no leaks found", which is
#      exactly what a clean repository reports. Refusing here is the difference between "clean" and
#      "nothing was examined".
#   4. EXCLUSIONS, PATHS ONLY. `.privacy-scan.json` at the repo root; rule-shaped exclusions are refused,
#      and the count loaded is printed -- a silent exclusion is indistinguishable from a silent pass.
#
# Exit: 0 clean · 1 finding · 2 cannot run · 3 nothing examined · 4 bad config
set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "privacy-gate: not inside a git repository" >&2; exit 2; }

cfg="$root/.privacy-scan.json"
# ⚠ THE BASE CONFIG IS HOOK-OWNED, NOT REPO-LOCAL (#50 review). `rules="$root/.gitleaks.toml"` is a
# NON-EMPTY STRING even when that file is absent, so the emptiness test chose a path that did not exist
# and Gitleaks failed -- a CLEAN CONSUMER WAS FALSELY REFUSED, measured. The base rules ship with the
# hook and are resolved from THIS SCRIPT's directory; a repository may add its own on top, merged.
hook_dir=$(cd "$(dirname "$0")" && pwd)
base="$hook_dir/../gitleaks.toml"
[ -f "$base" ] || base=""
rules="$base"
if [ -f "$root/.gitleaks.toml" ]; then
  merged=$(mktemp); mktemp_done=1
  [ -n "$base" ] && grep -v '^\[extend\]\|^useDefault' "$base" > "$merged"
  grep -v '^\[extend\]\|^useDefault' "$root/.gitleaks.toml" | grep -v '^title = ' >> "$merged"
  rules="$merged"
fi
excl=""
nexcl=0
if [ -f "$cfg" ]; then
  # ⚠ PATHS ONLY, AND VALIDATED, NOT SUBSTRING-CHECKED (#50 review). The first version only looked for
  # the substring `"rule"` and trusted every value. Measured: `{"exclude_paths":[".*"]}` made a staged
  # token exit **0** — a catch-all exclusion that silently defeated detection, and `.` / `*` split on
  # shell whitespace into four phantom entries. An exclusion is a statement about ONE file a repository
  # has decided is a fixture; anything pattern-shaped is a rule, whatever its id.
  excl=$(python3 - "$cfg" <<'PY' || { echo "privacy-gate: .privacy-scan.json is invalid -- refusing" >&2; exit 4; }
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
paths = d.get("exclude_paths", [])
if not isinstance(paths, list) or any(not isinstance(p, str) for p in paths):
    sys.exit(1)
BANNED = ("*", "?", "[", "]", "(", ")", "{", "}", "|", "^", "$", "+", "\\")
for p in paths:
    s = p.strip()
    if (not s or s in (".", "..", "/") or "rule" in s.lower()
            or any(ch in s for ch in BANNED) or s.startswith("**")):
        sys.exit(1)
print("\n".join(x.strip() for x in paths))
PY
) || exit 4
  if [ -n "$excl" ]; then nexcl=$(printf '%s\n' "$excl" | wc -l | tr -d ' '); else nexcl=0; fi
fi

# (2)+(3) THE POPULATION, counted here because Gitleaks counts commits.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  echo "privacy-gate: no staged files -- nothing was scanned (not a pass)" >&2; exit 3; fi

scanned=0; skipped=0
# ⚠ EXACT LINE MATCH, NOT WORD SPLITTING. `for e in $excl` splits on whitespace, which turned one
# pattern-shaped entry into four phantom ones; and a pipeline would put the counters in a subshell.
while IFS= read -r f; do
  [ -n "$f" ] || continue
  hit=0
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    case "$f" in "$e"|"$e"/*) hit=1; break ;; esac
  done <<EOF
$excl
EOF
  if [ "$hit" = 1 ]; then skipped=$((skipped+1)); else scanned=$((scanned+1)); fi
done <<EOF
$staged
EOF
echo "privacy-gate: staged=$((scanned+skipped)) scanned=$scanned excluded=$skipped exclusions_loaded=$nexcl" >&2

if [ "$scanned" = 0 ]; then
  echo "privacy-gate: every staged file is excluded -- nothing was scanned (not a pass)" >&2; exit 3; fi

# ⚠ EXCLUSIONS MUST REACH THE DETECTOR, NOT ONLY MY COUNT. First version filtered the population
# arithmetic but handed Gitleaks the whole staged set, so an excluded file still reddened the gate --
# measured: `scanned=1 excluded=2` alongside "REFUSED", because real.txt was in the list and Gitleaks
# saw it anyway. The excluded paths are written into the gitleaks config as allowlist paths.
# ⚠ ANY `--config` REPLACES THE DEFAULT RULESET (#50 review, measured). An allowlist-only config made
# `leaks found: 2` become exit **0** -- the exclusion silently disabled every default rule, which is the
# vacuous pass again in a new place. So: pass no config at all when there are no exclusions, and when
# there are, EXTEND the defaults rather than replace them.
# ⚠ PRECEDENCE, AND WHY EVERY BRANCH EXTENDS. Any `--config` replaces the default ruleset, so a config
# that does not extend disables every maintained rule. Measured: an allowlist-only file turned
# `leaks found: 2` into exit 0. So:
#   - no repo rules, no exclusions -> no config at all (pure defaults)
#   - repo rules, no exclusions    -> the repo config as written (it carries [extend] itself)
#   - exclusions present           -> repo config (or a stub) PLUS an [extend] and the allowlist,
#                                     emitted in that order so TOML does not absorb them into the last rule
allowlist=""
if [ -n "$excl" ]; then
  allowlist=$(printf '%s\n' "$excl" | sed 's|.*|"^&(/.*)?$"|' | paste -sd, -)
fi

if [ -z "$allowlist" ] && [ -z "$rules" ]; then
  cfgfile=""
elif [ -z "$allowlist" ]; then
  cfgfile="$rules"
else
  cfgfile=$(mktemp); mktemp_done=1
  if [ -f "$rules" ]; then
    # keep the repo's rules, drop nothing, then re-open a section for extend+allowlist
    grep -v '^\[extend\]' "$rules" | grep -v '^useDefault' > "$cfgfile"
  else
    echo 'title = "home-conf privacy"' > "$cfgfile"
  fi
  printf '\n[extend]\nuseDefault = true\n\n[[allowlists]]\npaths = [%s]\n' "$allowlist" >> "$cfgfile"
fi

# ⚠ THE PINNED BINARY, NOT PATH (#50, @CowBoy). `gitleaks` on PATH is an ambient dependency: it can be
# any version, and a gate whose detector resolves differently per machine is not a gate. The pin path is
# fixed; if the binary is absent the gate fails BY NAME rather than borrowing one.
GL_VERSION=8.30.1
GL_PIN="${HOME}/.local/share/home-conf/gitleaks/${GL_VERSION}/gitleaks"
if [ -x "$GL_PIN" ]; then
  gl="$GL_PIN"
else
  echo "privacy-gate: pinned gitleaks ${GL_VERSION} is absent at ${GL_PIN}" >&2
  echo "privacy-gate: run skills/privacy-review/scripts/setup-gitleaks.sh -- refusing to fall back to PATH" >&2
  exit 2
fi

# ⚠ `--exit-code 1` IS EXPLICIT AS A GUARD, NOT BECAUSE THE DEFAULT IS 0. `gitleaks git --help` reports
# `--exit-code int … (default 1)`, and both @CowBoy and @GameBoy measured exit 1 on every arm without the
# flag. My earlier note that "without it the positive arm exits 0" was a PIPELINE ARTIFACT: `cmd | tail`
# reports `tail`'s status, which is what I read. The pin makes the question moot.
args="--staged --redact --exit-code 1 --no-banner"
[ -n "$cfgfile" ] && args="$args --config $cfgfile"

out=$( cd "$root" && "$gl" git $args 2>&1 ); rc=$?
# ⚠ ONLY DELETE A FILE THIS RUN CREATED (#50 review). `cfgfile` can be the HOOK-OWNED base config, which
# lives outside the consumer's root -- so the old "outside $root" guard deleted the shipped rules, and
# prek reported "files were modified by this hook". Track what we made, not where it happens to live.
[ -n "${mktemp_done:-}" ] && [ -n "$cfgfile" ] && rm -f "$cfgfile"
printf '%s\n' "$out" | grep -viE '^[0-9]{1,2}:[0-9]{2}(AM|PM)' >&2 || true

case "$rc" in
  0) echo "privacy-gate: clean ($scanned file(s) scanned, $skipped excluded)" >&2; exit 0 ;;
  1) echo "privacy-gate: REFUSED. Fix the source; this gate never rewrites content." >&2; exit 1 ;;
  126|127) echo "privacy-gate: gitleaks not found -- refusing rather than passing" >&2; exit 2 ;;
  *) echo "privacy-gate: gitleaks exited $rc -- refusing rather than passing" >&2; exit 2 ;;
esac
