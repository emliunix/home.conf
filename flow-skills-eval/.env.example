# OpenAI-compatible API configuration for the live decision evaluation.
# Keep the secret in this project's ignored .env file; never commit it.
FLOW_SKILLS_EVAL_API_BASE_URL=https://api.example.com/v1
FLOW_SKILLS_EVAL_API_KEY=replace-me
# Optional: defaults to claude-sonnet-4-5 (the model family that consumes the skills).
#FLOW_SKILLS_EVAL_MODEL=gpt-4o-mini
# Optional: smoke (default) runs L1 canonical cases only; full runs all triplets.
#FLOW_SKILLS_EVAL_PROFILE=full
